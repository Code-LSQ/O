/* ============================================================
   Aurora.qss — 浅色渐变主题
   配色: 柔白 + 蓝灰 + #1a73e8 强调色
   ============================================================ */

/* ——— 窗口 / 容器 ——— */
QMainWindow, QDialog {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fafafa, stop:1 #f2f2f2);
    color: #1a1a1a;
}
QWidget {
    background-color: #fafafa;
    color: #1a1a1a;
}
QFrame {
    border: none;
    background-color: transparent;
}
QGroupBox {
    border: 1px solid #d4d4d4;
    border-radius: 6px;
    margin-top: 8px;
    padding: 10px 10px 8px 10px;
    font-weight: 600;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f6f6f6);
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #1a73e8;
}
QScrollArea {
    border: none;
    background-color: transparent;
}

/* ——— 工具栏 / 菜单 ——— */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f5f5f5, stop:1 #e8e8e8);
    border: none;
    border-bottom: 1px solid #e0e0e0;
    padding: 1px 4px;
    spacing: 2px;
}
QToolButton {
    background-color: transparent;
    color: #1a1a1a;
    padding: 2px 10px;
    border: none;
    border-radius: 4px;
}
QToolButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e4e4e4, stop:1 #d4d4d4);
}
QToolButton:pressed, QToolButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #d0d0d0, stop:1 #c0c0c0);
}
QToolButton::menu-indicator { width: 0px; }
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f2f2f2, stop:1 #e8e8e8);
    color: #1a1a1a;
    border-bottom: 1px solid #e0e0e0;
}
QMenuBar::item {
    padding: 5px 12px;
    background: transparent;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e4e4e4, stop:1 #d4d4d4);
}
QMenu {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f6f6f6);
    color: #1a1a1a;
    border: 1px solid #d4d4d4;
    border-radius: 6px;
    padding: 4px 0;
}
QMenu::item {
    padding: 6px 28px;
    background: transparent;
}
QMenu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ececec, stop:1 #e0e0e0);
    color: #1a1a1a;
}
QMenu::separator {
    height: 1px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #e0e0e0, stop:0.5 #d0d0d0, stop:1 #e0e0e0);
    margin: 4px 12px;
}

/* ——— 标签页 ——— */
QTabWidget::pane {
    border: none;
}
QTabBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f2f2f2, stop:1 #e8e8e8);
}
QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 transparent, stop:1 transparent);
    color: #666666;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin: 0 1px;
}
QTabBar::tab:selected {
    color: #1a73e8;
    border-bottom: 2px solid #1a73e8;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(0,120,212,0.04), stop:1 rgba(0,120,212,0.08));
}
QTabBar::tab:hover {
    color: #1a73e8;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(0,120,212,0.02), stop:1 rgba(0,120,212,0.06));
}

/* ——— 编辑器 ——— */
QPlainTextEdit, QTextEdit, QTextBrowser {
    background-color: #ffffff;
    color: #1a1a1a;
    border: none;
    selection-background-color: #1a73e8;
    selection-color: #ffffff;
}

/* ——— 滚动条 ——— */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    border: none;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: qlineargradient(x1:1, y1:0, x2:0, y2:0,
                                stop:0 #d0d0d0, stop:1 #c0c0c0);
    border-radius: 5px;
    min-height: 30px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:1, y1:0, x2:0, y2:0,
                                stop:0 #a8a8a8, stop:1 #989898);
}
QScrollBar::handle:vertical:pressed {
    background: qlineargradient(x1:1, y1:0, x2:0, y2:0,
                                stop:0 #1a73e8, stop:1 #005a9e);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    border: none;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
                                stop:0 #d0d0d0, stop:1 #c0c0c0);
    border-radius: 5px;
    min-width: 30px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
                                stop:0 #a8a8a8, stop:1 #989898);
}
QScrollBar::handle:horizontal:pressed {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
                                stop:0 #1a73e8, stop:1 #005a9e);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ——— 按钮 ——— */
QPushButton {
    border: 1px solid #d4d4d4;
    color: #1a1a1a;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f0f0f0);
    padding: 4px 8px;
    border-radius: 4px;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f5f5f5, stop:1 #e4e4e4);
    border-color: #b0b0b0;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e0e0e0, stop:1 #d0d0d0);
}
QPushButton:disabled {
    color: #b0b0b0;
    border-color: #e4e4e4;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f8f8f8, stop:1 #f0f0f0);
}
QPushButton:default {
    border-color: #1a73e8;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a73e8, stop:1 #005a9e);
    color: #ffffff;
}
QPushButton:default:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a8ad4, stop:1 #006aae);
    border-color: #1a8ad4;
}
QPushButton:default:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #005a9e, stop:1 #004a8e);
}

QRadioButton {
    color: #1a1a1a;
    spacing: 6px;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #b0b0b0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f0f0f0);
}
QRadioButton::indicator:hover {
    border-color: #1a73e8;
}
QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a73e8, stop:1 #005a9e);
    border-color: #1a73e8;
}

/* ——— 复选框 ——— */
QCheckBox {
    color: #1a1a1a;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #b0b0b0;
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f0f0f0);
}
QCheckBox::indicator:hover {
    border-color: #1a73e8;
}
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a73e8, stop:1 #005a9e);
    border-color: #1a73e8;
}
QCheckBox::indicator:disabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f0f0, stop:1 #e8e8e8);
    border-color: #d4d4d4;
}

/* ——— 输入框 / 下拉框 ——— */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f8f8f8);
    color: #1a1a1a;
    border: 1px solid #d4d4d4;
    padding: 5px 8px;
    border-radius: 4px;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #b0b0b0;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #1a73e8;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f0f7ff);
}
QComboBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f8f8f8);
    color: #1a1a1a;
    border: 1px solid #d4d4d4;
    padding: 5px 8px;
    border-radius: 4px;
}
QComboBox:hover {
    border: 1px solid #b0b0b0;
}
QComboBox:focus, QComboBox:on {
    border: 1px solid #1a73e8;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #e0e0e0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f8f8f8, stop:1 #e8e8e8);
}
QComboBox::down-arrow { width: 10px; height: 10px; }
QComboBox QAbstractItemView {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f6f6f6);
    color: #1a1a1a;
    border: 1px solid #d4d4d4;
    border-radius: 4px;
    selection-background-color: #ececec;
    selection-color: #1a1a1a;
    outline: none;
    padding: 2px;
}

/* ——— 列表 / 树 / 表格 ——— */
QListWidget, QTreeWidget, QTableWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #fafafa);
    color: #1a1a1a;
    border: 1px solid #e4e4e4;
    border-radius: 4px;
    outline: none;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    padding: 5px 8px;
    border: none;
}
QListWidget::item:hover, QTreeWidget::item:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f4f4f4, stop:1 #eaeaea);
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e8e8e8, stop:1 #dcdcdc);
    color: #1a1a1a;
}
QListWidget::item:selected:!active, QTreeWidget::item:selected:!active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f4f4f4, stop:1 #eaeaea);
}
QListWidget::item:focus, QTreeWidget::item:focus { outline: none; }
QListWidget#settings_tab_list {
    border: 1px solid #e4e4e4;
    background: transparent;
    outline: none;
}
QListWidget#settings_tab_list::item {
    padding: 4px 8px;
    border-bottom: 1px solid #e4e4e4;
}
QListWidget#settings_tab_list::item:hover {
    background: #f1f1f1;
}
QListWidget#settings_tab_list::item:selected {
    background: #dcdcdc;
    color: inherit;
}
QListWidget#settings_tab_list::item:focus { outline: none; }
QTableWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a73e8, stop:1 #005a9e);
    color: #ffffff;
}
QTableWidget::item:alternate {
    background-color: #f7f7f7;
}

QHeaderView {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f8f8f8, stop:1 #f0f0f0);
    border: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fafafa, stop:1 #eeeeee);
    color: #1a1a1a;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #d8d8d8;
    border-bottom: 1px solid #d8d8d8;
    font-weight: 600;
}
QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f0f0, stop:1 #e4e4e4);
}

/* ——— 状态栏 / 提示 / 进度条 ——— */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f0f0, stop:1 #e8e8e8);
    color: #666666;
    border-top: 1px solid #e0e0e0;
}
QToolTip {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #fafafa);
    color: #1a1a1a;
    border: 1px solid #d4d4d4;
    padding: 6px 12px;
    border-radius: 4px;
}
QProgressBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ececec, stop:1 #e0e0e0);
    color: #1a1a1a;
    border: none;
    border-radius: 4px;
    text-align: center;
    height: 20px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #1a73e8, stop:0.5 #4fc3f7, stop:1 #1a73e8);
    border-radius: 4px;
}

/* 炫彩进度条：七色渐变，供通用进度条组件复用 */
QProgressBar#rainbow {
    background: #ececec;
    border: none;
    border-radius: 4px;
    height: 8px;
}
QProgressBar#rainbow::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0d47a1, stop:0.2 #1976d2, stop:0.4 #42a5f5,
                                stop:0.6 #64b5f6, stop:0.8 #4dd0e1, stop:1 #7e57c2);
    border-radius: 4px;
}

/* ——— 滑块 ——— */
QSlider::groove:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e0e0e0, stop:1 #d0d0d0);
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f0f0f0);
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
    border: 2px solid #b0b0b0;
}
QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a73e8, stop:1 #005a9e);
    border-color: #1a73e8;
}
QSlider::groove:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #e0e0e0, stop:1 #d0d0d0);
    width: 4px;
    border-radius: 2px;
}
QSlider::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f0f0f0);
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
    border: 2px solid #b0b0b0;
}
QSlider::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a73e8, stop:1 #005a9e);
    border-color: #1a73e8;
}

/* ——— 分割器 ——— */
QSplitter { background: transparent; }
QSplitter::handle {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 transparent, stop:0.5 #e0e0e0, stop:1 transparent);
}
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 transparent, stop:0.5 #1a73e8, stop:1 transparent);
}

/* ——— 对话框按钮 ——— */
QDialogButtonBox QPushButton {
    min-width: 80px;
    padding: 6px 20px;
}

/* ——— 停靠窗口 ——— */
QDockWidget {
    color: #1a1a1a;
}
QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f0f0, stop:1 #e4e4e4);
    padding: 6px 12px;
    border-bottom: 1px solid #d0d0d0;
    text-align: left;
    font-weight: 600;
}

/* ============================================================
   私有组件
   ============================================================ */

QLabel#cpu_label {
    padding: 0 12px;
    color: #666666;
    background: transparent;
}

QWidget#line_number_area {
    background-color: #f5f5f5;
    border-right: 1px solid #e4e4e4;
}

QWidget#toc_panel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fcfcfc, stop:1 #f4f4f4);
}

QListWidget#toc_list {
    border: none;
    background: transparent;
}
QListWidget#toc_list::item {
    padding: 2px 10px;
    border-radius: 3px;
    margin: 1px 4px;
}
QListWidget#toc_list::item:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f0f0, stop:1 #e4e4e4);
}
QListWidget#toc_list::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e4e4e4, stop:1 #d4d4d4);
    color: inherit;
}
QListWidget#toc_list::item:focus { outline: none; }

QPushButton#min_btn, QPushButton#max_btn, QPushButton#close_btn {
    border: none;
    border-radius: 0;
    background: transparent;
}
QPushButton#min_btn:hover, QPushButton#max_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(0,0,0,0.06), stop:1 rgba(0,0,0,0.10));
}
QPushButton#close_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e81123, stop:1 #c01020);
}

QLabel#folder_header {
    padding: 6px 10px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f5f5f5, stop:1 #eaeaea);
    font-weight: 600;
    border-bottom: 1px solid #e0e0e0;
}

QLabel#duplicate_header {
    padding: 6px 10px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f5f5f5, stop:1 #eaeaea);
    font-weight: 600;
    border-bottom: 1px solid #e0e0e0;
}

QWidget#title_bar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f5f5f5, stop:1 #eaeaea);
}

QWidget#bottom_bar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f8f8f8, stop:1 #eeeeee);
    border-top: 1px solid #e0e0e0;
}

QDockWidget#AIViewDock {
    background-color: #fafafa;
}

QFrame#ai_top_bar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f5f5f5, stop:1 #eaeaea);
    border-bottom: 1px solid #e0e0e0;
    padding: 4px;
}

QFrame#msg_frame {
    border-bottom: 1px solid #eeeeee;
    padding: 4px 8px;
}

/* ============================================================
   启动器组件
   ============================================================ */

QFrame#sep_h {
    color: #e0e0e0;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 transparent, stop:0.5 #d0d0d0, stop:1 transparent);
    max-height: 1px;
    border: none;
}

QFrame#sep_v {
    color: #e0e0e0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 transparent, stop:0.5 #d0d0d0, stop:1 transparent);
    max-width: 1px;
    border: none;
}

QWidget#launcher_tools, QWidget#launcher_content {
    background: transparent;
}

QFrame#group_frame {
    background: transparent;
}

QScrollArea#tools_scroll {
    border: none;
    background: transparent;
}

QPushButton#group_btn {
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #1a1a1a;
    font-size: 14px;
}

QPushButton#group_btn:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #eaeaea, stop:1 #dcdcdc);
    color: #1a73e8;
    font-weight: 600;
}

QPushButton#group_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f0f0, stop:1 #e4e4e4);
}

QToolButton#tool_btn {
    border: none;
    background: transparent;
    padding: 4px 2px;
    font-size: 14px;
    border-radius: 4px;
}

QToolButton#tool_btn:hover {
    background: rgba(0, 0, 0, 0.06);
}

QToolButton#tool_btn[dragging=true] {
    background: rgba(26, 115, 232, 0.15);
    border: 1px dashed #1a73e8;
}

QPushButton#settings_btn {
    border: none;
    border-radius: 0;
    background: transparent;
    color: #1a1a1a;
    font-size: 14px;
}

QPushButton#settings_btn:hover {
    background: rgba(0, 0, 0, 0.06);
}

QMenu#tray {
    background: #ffffff;
    border: 1px solid #d4d4d4;
}

QMenu#tray::item {
    padding: 4px 16px;
    background: transparent;
}

QMenu#tray::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ececec, stop:1 #e0e0e0);
}
