/* ============================================================
   UI_Gray.qss — 灰色主题
   配色: 冷灰 + 石板蓝 + #5a5a5a 强调色
   ============================================================ */

/* ——— 窗口 / 容器 ——— */
QMainWindow, QDialog {
    background-color: #f0f0f0;
    color: #1e1e1e;
}
QWidget {
    background-color: #f0f0f0;
    color: #1e1e1e;
}
QFrame {
    border: none;
    background-color: transparent;
}
QGroupBox {
    border: 1px solid #c0c0c0;
    border-radius: 6px;
    margin-top: 14px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
    background: #f8f8f8;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #5a5a5a;
}
QScrollArea {
    border: none;
    background-color: transparent;
}

/* ——— 工具栏 / 菜单 ——— */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ececec, stop:1 #e0e0e0);
    border: none;
    border-bottom: 1px solid #d0d0d0;
    padding: 1px 4px;
    spacing: 2px;
}
QToolButton {
    background-color: transparent;
    color: #1e1e1e;
    padding: 2px 10px;
    border: none;
    border-radius: 4px;
}
QToolButton:hover {
    background-color: #d0d0d0;
}
QToolButton:pressed, QToolButton:checked {
    background-color: #bebebe;
}
QToolButton::menu-indicator {
    width: 0px;
}
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ececec, stop:1 #e0e0e0);
    color: #1e1e1e;
    border-bottom: 1px solid #d0d0d0;
}
QMenuBar::item {
    padding: 5px 12px;
    background: transparent;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #d0d0d0;
}
QMenu {
    background-color: #f8f8f8;
    color: #1e1e1e;
    border: 1px solid #c0c0c0;
    border-radius: 6px;
    padding: 4px 0;
}
QMenu::item {
    padding: 6px 28px;
    background: transparent;
}
QMenu::item:selected {
    background-color: #d8d8d8;
    color: #1e1e1e;
}
QMenu::separator {
    height: 1px;
    background: #d0d0d0;
    margin: 4px 12px;
}

/* ——— 标签页 ——— */
QTabWidget::pane {
    border: none;
    background-color: #f0f0f0;
}
QTabBar {
    background: #e8e8e8;
}
QTabBar::tab {
    background-color: transparent;
    color: #888888;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin: 0 1px;
}
QTabBar::tab:selected {
    color: #5a5a5a;
    border-bottom: 2px solid #5a5a5a;
    background: transparent;
}
QTabBar::tab:hover {
    color: #5a5a5a;
    background-color: rgba(90, 90, 90, 0.06);
}

/* ——— 编辑器 ——— */
QPlainTextEdit, QTextEdit, QTextBrowser {
    background-color: #fafafa;
    color: #1e1e1e;
    border: none;
    selection-background-color: #888888;
    selection-color: #ffffff;
}

/* ——— 滚动条 ——— */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    border: none;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #bebebe;
    border-radius: 5px;
    min-height: 30px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}
QScrollBar::handle:vertical:pressed {
    background-color: #5a5a5a;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    border: none;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background-color: #bebebe;
    border-radius: 5px;
    min-width: 30px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}
QScrollBar::handle:horizontal:pressed {
    background-color: #5a5a5a;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ——— 按钮 ——— */
QPushButton {
    border: 1px solid #c0c0c0;
    color: #1e1e1e;
    background-color: #f8f8f8;
    padding: 6px 16px;
    border-radius: 4px;
}
QPushButton:hover {
    background-color: #eaeaea;
    border-color: #a0a0a0;
}
QPushButton:pressed {
    background-color: #d8d8d8;
}
QPushButton:disabled {
    color: #b0b0b0;
    border-color: #d8d8d8;
    background-color: #f4f4f4;
}
QPushButton:default {
    border-color: #5a5a5a;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5a5a5a, stop:1 #3a3a3a);
    color: #ffffff;
}
QPushButton:default:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4a4a4a, stop:1 #2a2a2a);
    border-color: #4a4a4a;
}
QPushButton:default:pressed {
    background-color: #3a3a3a;
}

QRadioButton {
    color: #1e1e1e;
    spacing: 6px;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #b0b0b0;
    background-color: #fafafa;
}
QRadioButton::indicator:hover {
    border-color: #5a5a5a;
}
QRadioButton::indicator:checked {
    background-color: #5a5a5a;
    border-color: #5a5a5a;
}
QRadioButton::indicator:checked:hover {
    background-color: #4a4a4a;
    border-color: #4a4a4a;
}

/* ——— 复选框 ——— */
QCheckBox {
    color: #1e1e1e;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #b0b0b0;
    border-radius: 4px;
    background-color: #fafafa;
}
QCheckBox::indicator:hover {
    border-color: #5a5a5a;
}
QCheckBox::indicator:checked {
    background-color: #5a5a5a;
    border-color: #5a5a5a;
}
QCheckBox::indicator:checked:hover {
    background-color: #4a4a4a;
    border-color: #4a4a4a;
}
QCheckBox::indicator:disabled {
    background-color: #e8e8e8;
    border-color: #d0d0d0;
}

/* ——— 输入框 / 下拉框 ——— */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #fafafa;
    color: #1e1e1e;
    border: 1px solid #c0c0c0;
    padding: 5px 8px;
    border-radius: 4px;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #a0a0a0;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #5a5a5a;
    background-color: #ffffff;
}
QComboBox {
    background-color: #fafafa;
    color: #1e1e1e;
    border: 1px solid #c0c0c0;
    padding: 5px 8px;
    border-radius: 4px;
}
QComboBox:hover {
    border: 1px solid #a0a0a0;
}
QComboBox:focus, QComboBox:on {
    border: 1px solid #5a5a5a;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #d8d8d8;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background-color: #fafafa;
    color: #1e1e1e;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    selection-background-color: #d8d8d8;
    selection-color: #1e1e1e;
    outline: none;
    padding: 2px;
}

/* ——— 列表 / 树 / 表格 ——— */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #fafafa;
    color: #1e1e1e;
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    outline: none;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    padding: 5px 8px;
    border: none;
}
QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #eaeaea;
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #d8d8d8;
    color: #1e1e1e;
}
QListWidget::item:selected:!active, QTreeWidget::item:selected:!active {
    background-color: #eaeaea;
}
QListWidget::item:focus, QTreeWidget::item:focus { outline: none; }
QTableWidget::item:selected {
    background-color: #5a5a5a;
    color: #ffffff;
}
QTableWidget::item:alternate {
    background-color: #f5f5f5;
}

QHeaderView {
    background-color: #e8e8e8;
    border: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f0f0, stop:1 #e0e0e0);
    color: #1e1e1e;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;
    font-weight: 600;
}
QHeaderView::section:hover {
    background-color: #dcdcdc;
}

/* ——— 状态栏 / 提示 / 进度条 ——— */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ececec, stop:1 #e0e0e0);
    color: #777777;
    border-top: 1px solid #d0d0d0;
}
QToolTip {
    background-color: #f8f8f8;
    color: #1e1e1e;
    border: 1px solid #c0c0c0;
    padding: 6px 12px;
    border-radius: 4px;
}
QProgressBar {
    background-color: #e0e0e0;
    color: #1e1e1e;
    border: none;
    border-radius: 4px;
    text-align: center;
    height: 20px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #5a5a5a, stop:1 #888888);
    border-radius: 4px;
}

/* ——— 滑块 ——— */
QSlider::groove:horizontal {
    background-color: #d8d8d8;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background-color: #fafafa;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
    border: 2px solid #a0a0a0;
}
QSlider::handle:horizontal:hover {
    background-color: #5a5a5a;
    border-color: #5a5a5a;
}
QSlider::groove:vertical {
    background-color: #d8d8d8;
    width: 4px;
    border-radius: 2px;
}
QSlider::handle:vertical {
    background-color: #fafafa;
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
    border: 2px solid #a0a0a0;
}
QSlider::handle:vertical:hover {
    background-color: #5a5a5a;
    border-color: #5a5a5a;
}

/* ——— 分割器 ——— */
QSplitter {
    background: transparent;
}
QSplitter::handle {
    background-color: #d8d8d8;
}
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover {
    background-color: #5a5a5a;
}

/* ——— 对话框按钮 ——— */
QDialogButtonBox QPushButton {
    min-width: 80px;
    padding: 6px 20px;
}

/* ——— 停靠窗口 ——— */
QDockWidget {
    color: #1e1e1e;
}
QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ececec, stop:1 #e0e0e0);
    padding: 6px 12px;
    border-bottom: 1px solid #d0d0d0;
    text-align: left;
    font-weight: 600;
}

/* ============================================================
   私有组件
   ============================================================ */

QLabel#cpu_label {
    padding: 0 12px;
    color: #777777;
}

QWidget#line_number_area {
    background-color: #eaeaea;
    border-right: 1px solid #d8d8d8;
}

QWidget#toc_panel {
    background-color: #f5f5f5;
}

QListWidget#toc_list {
    border: none;
    background: transparent;
}
QListWidget#toc_list::item {
    padding: 2px 10px;
    border-radius: 3px;
    margin: 1px 4px;
}
QListWidget#toc_list::item:hover {
    background: #e0e0e0;
}
QListWidget#toc_list::item:selected {
    background: #d0d0d0;
    color: inherit;
}
QListWidget#toc_list::item:focus { outline: none; }

QPushButton#min_btn, QPushButton#max_btn, QPushButton#close_btn {
    border: none;
    border-radius: 0;
    background: transparent;
    padding: 4px 14px;
}
QPushButton#min_btn:hover, QPushButton#max_btn:hover {
    background: rgba(0, 0, 0, 0.1);
}
QPushButton#close_btn:hover {
    background: #e81123;
    color: white;
}

QLabel#folder_header {
    padding: 6px 10px;
    background: #e8e8e8;
    font-weight: 600;
    border-bottom: 1px solid #d0d0d0;
}

QLabel#duplicate_header {
    padding: 6px 10px;
    background: #e8e8e8;
    font-weight: 600;
    border-bottom: 1px solid #d0d0d0;
}

QWidget#title_bar {
    background-color: #e8e8e8;
    border-bottom: 1px solid #d0d0d0;
}

QWidget#bottom_bar {
    background-color: #ececec;
    border-top: 1px solid #d0d0d0;
}

QDockWidget#AIViewDock {
    background-color: #f0f0f0;
}

QFrame#ai_top_bar {
    background-color: #e8e8e8;
    border-bottom: 1px solid #d0d0d0;
    padding: 4px;
}

QFrame#msg_frame {
    border-bottom: 1px solid #e0e0e0;
    padding: 4px 8px;
}

/* ============================================================
   启动器组件
   ============================================================ */

QFrame#sep_h {
    color: #d0d0d0;
    background-color: #d0d0d0;
    max-height: 1px;
    border: none;
}

QFrame#sep_v {
    color: #d0d0d0;
    background-color: #d0d0d0;
    max-width: 1px;
    border: none;
}

QWidget#launcher_tools, QWidget#launcher_content {
    background: transparent;
}

QFrame#group_frame {
    background: transparent;
}

QScrollArea#tools_scroll {
    border: none;
    background: transparent;
}

QPushButton#group_btn {
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #1e1e1e;
    font-size: 14px;
}

QPushButton#group_btn:checked {
    background: #d8d8d8;
    font-weight: 600;
}

QPushButton#group_btn:hover {
    background: #e4e4e4;
}

QToolButton#tool_btn {
    border: none;
    background: transparent;
    padding: 4px 2px;
    font-size: 14px;
    border-radius: 4px;
}

QToolButton#tool_btn:hover {
    background: rgba(0, 0, 0, 0.08);
}

QToolButton#tool_btn[dragging=true] {
    background: rgba(90, 90, 90, 0.25);
    border: 1px dashed #5a5a5a;
}

QPushButton#settings_btn {
    border: none;
    border-radius: 0;
    background: transparent;
    color: #1e1e1e;
    font-size: 14px;
}

QPushButton#settings_btn:hover {
    background: rgba(0, 0, 0, 0.08);
}

QMenu#tray {
    background: #f8f8f8;
    border: 1px solid #c0c0c0;
}

QMenu#tray::item {
    padding: 4px 16px;
    background: transparent;
}

QMenu#tray::item:selected {
    background: #d8d8d8;
}
