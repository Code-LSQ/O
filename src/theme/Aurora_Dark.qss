/* ============================================================
   Aurora_Dark.qss — 深色渐变主题
   配色: 深灰 + 浅灰 + #007acc 强调色
   ============================================================ */

/* ——— 窗口 / 容器 ——— */
QMainWindow, QDialog {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1e1e1e, stop:1 #232323);
    color: #d4d4d4;
}
QWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
}
QFrame {
    border: none;
    background-color: transparent;
}
QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    margin-top: 8px;
    padding: 10px 10px 8px 10px;
    font-weight: 600;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #252526, stop:1 #2a2a2a);
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #007acc;
}
QScrollArea {
    border: none;
    background-color: transparent;
}

/* ——— 工具栏 / 菜单 ——— */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #1e1e1e);
    border: none;
    border-bottom: 1px solid #3c3c3c;
    padding: 1px 4px;
    spacing: 2px;
}
QToolButton {
    background-color: transparent;
    color: #cccccc;
    padding: 2px 10px;
    border: none;
    border-radius: 4px;
}
QToolButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #444444, stop:1 #353535);
}
QToolButton:pressed, QToolButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #505050, stop:1 #424242);
}
QToolButton::menu-indicator { width: 0px; }
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #1e1e1e);
    color: #d4d4d4;
    border-bottom: 1px solid #3c3c3c;
}
QMenuBar::item {
    padding: 5px 12px;
    background: transparent;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #424242, stop:1 #343434);
}
QMenu {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #252526, stop:1 #2a2a2a);
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 4px 0;
}
QMenu::item {
    padding: 6px 28px;
    background: transparent;
}
QMenu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #424242, stop:1 #343434);
    color: #d4d4d4;
}
QMenu::separator {
    height: 1px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3c3c3c, stop:0.5 #4a4a4a, stop:1 #3c3c3c);
    margin: 4px 12px;
}

/* ——— 标签页 ——— */
QTabWidget::pane { border: none; }
QTabBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #282828, stop:1 #222222);
}
QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 transparent, stop:1 transparent);
    color: #888888;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin: 0 1px;
}
QTabBar::tab:selected {
    color: #007acc;
    border-bottom: 2px solid #007acc;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(0,122,204,0.06), stop:1 rgba(0,122,204,0.10));
}
QTabBar::tab:hover {
    color: #007acc;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(0,122,204,0.04), stop:1 rgba(0,122,204,0.08));
}

/* ——— 编辑器 ——— */
QPlainTextEdit, QTextEdit, QTextBrowser {
    background-color: #2a2a2a;
    color: #d4d4d4;
    border: none;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

/* ——— 滚动条 ——— */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    border: none;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: qlineargradient(x1:1, y1:0, x2:0, y2:0,
                                stop:0 #4a4a4a, stop:1 #3a3a3a);
    border-radius: 5px;
    min-height: 30px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:1, y1:0, x2:0, y2:0,
                                stop:0 #585858, stop:1 #484848);
}
QScrollBar::handle:vertical:pressed {
    background: qlineargradient(x1:1, y1:0, x2:0, y2:0,
                                stop:0 #007acc, stop:1 #005a9e);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    border: none;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
                                stop:0 #4a4a4a, stop:1 #3a3a3a);
    border-radius: 5px;
    min-width: 30px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
                                stop:0 #585858, stop:1 #484848);
}
QScrollBar::handle:horizontal:pressed {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
                                stop:0 #007acc, stop:1 #005a9e);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ——— 按钮 ——— */
QPushButton {
    border: 1px solid #3c3c3c;
    color: #d4d4d4;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #323232, stop:1 #282828);
    padding: 4px 8px;
    border-radius: 4px;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #424242, stop:1 #383838);
    border-color: #505050;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #505050, stop:1 #424242);
}
QPushButton:disabled {
    color: #555555;
    border-color: #2d2d2d;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #222222);
}
QPushButton:default {
    border-color: #007acc;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #007acc, stop:1 #005a9e);
    color: #ffffff;
}
QPushButton:default:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a8ad4, stop:1 #006aae);
    border-color: #1a8ad4;
}
QPushButton:default:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #005a9e, stop:1 #004a8e);
}

QRadioButton {
    color: #d4d4d4;
    spacing: 6px;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #555555;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #383838, stop:1 #2a2a2a);
}
QRadioButton::indicator:hover {
    border-color: #007acc;
}
QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #007acc, stop:1 #005a9e);
    border-color: #007acc;
}

/* ——— 复选框 ——— */
QCheckBox {
    color: #d4d4d4;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #555555;
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #383838, stop:1 #2a2a2a);
}
QCheckBox::indicator:hover {
    border-color: #007acc;
}
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #007acc, stop:1 #005a9e);
    border-color: #007acc;
}
QCheckBox::indicator:disabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #222222);
    border-color: #3c3c3c;
}

/* ——— 输入框 / 下拉框 ——— */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #323232, stop:1 #282828);
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    padding: 5px 8px;
    border-radius: 4px;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #555555;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #007acc;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #323232, stop:1 #2a2a30);
}
QComboBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #323232, stop:1 #282828);
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    padding: 5px 8px;
    border-radius: 4px;
}
QComboBox:hover {
    border: 1px solid #555555;
}
QComboBox:focus, QComboBox:on {
    border: 1px solid #007acc;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #3c3c3c;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #383838, stop:1 #2e2e2e);
}
QComboBox::down-arrow { width: 10px; height: 10px; }
QComboBox QAbstractItemView {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2d2d2d, stop:1 #252525);
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    selection-background-color: #424242;
    selection-color: #d4d4d4;
    outline: none;
    padding: 2px;
}

/* ——— 列表 / 树 / 表格 ——— */
QListWidget, QTreeWidget, QTableWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #252526, stop:1 #2a2a2a);
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    outline: none;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    padding: 5px 8px;
    border: none;
}
QListWidget::item:hover, QTreeWidget::item:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #383838, stop:1 #2e2e2e);
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #424242, stop:1 #343434);
    color: #d4d4d4;
}
QListWidget::item:selected:!active, QTreeWidget::item:selected:!active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #383838, stop:1 #2e2e2e);
}
QListWidget::item:focus, QTreeWidget::item:focus { outline: none; }
QTableWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #264f78, stop:1 #1e3f68);
    color: #ffffff;
}
QTableWidget::item:alternate {
    background-color: #2a2a2a;
}

QHeaderView {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #222222);
    border: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #303030, stop:1 #262626);
    color: #d4d4d4;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #3c3c3c;
    border-bottom: 1px solid #3c3c3c;
    font-weight: 600;
}
QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #383838, stop:1 #2e2e2e);
}

/* ——— 状态栏 / 提示 / 进度条 ——— */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #1e1e1e);
    color: #888888;
    border-top: 1px solid #3c3c3c;
}
QToolTip {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2d2d2d, stop:1 #252525);
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    padding: 6px 12px;
    border-radius: 4px;
}
QProgressBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #323232, stop:1 #282828);
    color: #d4d4d4;
    border: none;
    border-radius: 4px;
    text-align: center;
    height: 20px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #007acc, stop:0.5 #4fc3f7, stop:1 #007acc);
    border-radius: 4px;
}

/* ——— 滑块 ——— */
QSlider::groove:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3c3c3c, stop:1 #2e2e2e);
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5a5a5a, stop:1 #4a4a4a);
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
    border: 2px solid #666666;
}
QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #007acc, stop:1 #005a9e);
    border-color: #007acc;
}
QSlider::groove:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3c3c3c, stop:1 #2e2e2e);
    width: 4px;
    border-radius: 2px;
}
QSlider::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5a5a5a, stop:1 #4a4a4a);
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
    border: 2px solid #666666;
}
QSlider::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #007acc, stop:1 #005a9e);
    border-color: #007acc;
}

/* ——— 分割器 ——— */
QSplitter { background: transparent; }
QSplitter::handle {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 transparent, stop:0.5 #3c3c3c, stop:1 transparent);
}
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 transparent, stop:0.5 #007acc, stop:1 transparent);
}

/* ——— 对话框按钮 ——— */
QDialogButtonBox QPushButton {
    min-width: 80px;
    padding: 6px 20px;
}

/* ——— 停靠窗口 ——— */
QDockWidget {
    color: #d4d4d4;
}
QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #1e1e1e);
    padding: 6px 12px;
    border-bottom: 1px solid #3c3c3c;
    text-align: left;
    font-weight: 600;
}

/* ============================================================
   私有组件
   ============================================================ */

QLabel#cpu_label {
    padding: 0 12px;
    color: #888888;
    background: transparent;
}

QWidget#line_number_area {
    background-color: #252526;
    border-right: 1px solid #3c3c3c;
}

QWidget#toc_panel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #282828, stop:1 #222222);
}

QListWidget#toc_list {
    border: none;
    background: transparent;
}
QListWidget#toc_list::item {
    padding: 2px 10px;
    border-radius: 3px;
    margin: 1px 4px;
}
QListWidget#toc_list::item:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #383838, stop:1 #2e2e2e);
}
QListWidget#toc_list::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #424242, stop:1 #343434);
    color: inherit;
}
QListWidget#toc_list::item:focus { outline: none; }

QPushButton#min_btn, QPushButton#max_btn, QPushButton#close_btn {
    border: none;
    border-radius: 0;
    background: transparent;
    padding: 4px 14px;
}
QPushButton#min_btn:hover, QPushButton#max_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255,255,255,0.08), stop:1 rgba(255,255,255,0.12));
}
QPushButton#close_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e81123, stop:1 #c01020);
    color: white;
}

QLabel#folder_header {
    padding: 6px 10px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #222222);
    font-weight: 600;
    border-bottom: 1px solid #3c3c3c;
}

QLabel#duplicate_header {
    padding: 6px 10px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #222222);
    font-weight: 600;
    border-bottom: 1px solid #3c3c3c;
}

QWidget#title_bar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #222222);
}

QWidget#bottom_bar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #282828, stop:1 #222222);
    border-top: 1px solid #3c3c3c;
}

QDockWidget#AIViewDock {
    background-color: #1e1e1e;
}

QFrame#ai_top_bar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #222222);
    border-bottom: 1px solid #3c3c3c;
    padding: 4px;
}

QFrame#msg_frame {
    border-bottom: 1px solid #333333;
    padding: 4px 8px;
}

/* ============================================================
   启动器组件
   ============================================================ */

QFrame#sep_h {
    color: #3c3c3c;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 transparent, stop:0.5 #3c3c3c, stop:1 transparent);
    max-height: 1px;
    border: none;
}

QFrame#sep_v {
    color: #3c3c3c;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 transparent, stop:0.5 #3c3c3c, stop:1 transparent);
    max-width: 1px;
    border: none;
}

QWidget#launcher_tools, QWidget#launcher_content {
    background: transparent;
}

QFrame#group_frame {
    background: transparent;
}

QScrollArea#tools_scroll {
    border: none;
    background: transparent;
}

QPushButton#group_btn {
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #d4d4d4;
    font-size: 14px;
}

QPushButton#group_btn:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3a3a3a, stop:1 #2a2a2a);
    color: #007acc;
    font-weight: 600;
}

QPushButton#group_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #383838, stop:1 #2e2e2e);
}

QToolButton#tool_btn {
    border: none;
    background: transparent;
    padding: 4px 2px;
    font-size: 14px;
    border-radius: 4px;
}

QToolButton#tool_btn:hover {
    background: rgba(255, 255, 255, 0.08);
}

QToolButton#tool_btn[dragging=true] {
    background: rgba(0, 122, 204, 0.25);
    border: 1px dashed #007acc;
}

QPushButton#settings_btn {
    border: none;
    border-radius: 0;
    background: transparent;
    color: #d4d4d4;
    font-size: 14px;
}

QPushButton#settings_btn:hover {
    background: rgba(255, 255, 255, 0.08);
}

QMenu#tray {
    background: #252526;
    border: 1px solid #3c3c3c;
}

QMenu#tray::item {
    padding: 4px 16px;
    background: transparent;
}

QMenu#tray::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #424242, stop:1 #343434);
}
